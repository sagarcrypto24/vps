# ⚠️ Copy this file to ".env" and fill in your REAL values there.
# ".env" is git-ignored — it must NEVER be committed or pushed to GitHub.

# Your deployer wallet's private key (needs BNB for gas).
# NEVER share this with anyone, including in chat, screenshots, or support tickets.
PRIVATE_KEY=

# Optional: custom RPC endpoints (defaults to public BSC RPCs if left blank)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org

# BscScan API key, for contract verification (get a free one at bscscan.com/myapikey)
BSCSCAN_API_KEY=

# Real BEP-20 token addresses to pair (fill in once you have them)
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
SHIB_TOKEN_ADDRESS=

# WBNB address (BSC mainnet — official, verified on BscScan)
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
